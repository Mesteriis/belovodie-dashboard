{
  "bc_action": {
    "show_state": false,
    "show_label": true,
    "show_icon": true,
    "show_name": true,
    "styles": {
      "card": [
        {
          "height": "100%"
        },
        {
          "box-sizing": "border-box"
        },
        {
          "border-radius": "22px"
        },
        {
          "border": "1px solid #1b4353"
        },
        {
          "background": "#102b38"
        },
        {
          "box-shadow": "none"
        },
        {
          "padding": "24px 28px"
        },
        {
          "color": "#dceef5"
        }
      ],
      "grid": [
        {
          "grid-template-areas": "\"i n arrow\""
        },
        {
          "grid-template-columns": "72px minmax(0,1fr) 24px"
        },
        {
          "grid-template-rows": "minmax(0,1fr)"
        }
      ],
      "name": [
        {
          "justify-self": "start"
        },
        {
          "font-size": "var(--bc-font)"
        },
        {
          "font-weight": 400
        },
        {
          "white-space": "normal"
        },
        {
          "text-align": "left"
        }
      ],
      "icon": [
        {
          "width": "clamp(26px,3vw,52px)"
        },
        {
          "color": "#48c7ef"
        }
      ],
      "label": [
        {
          "font-size": "var(--bc-small)"
        },
        {
          "color": "#9fc5d6"
        }
      ],
      "custom_fields": {
        "arrow": [
          {
            "color": "#91b9ce"
          },
          {
            "justify-self": "end"
          }
        ]
      }
    },
    "custom_fields": {
      "arrow": "<ha-icon icon=\"mdi:chevron-right\" style=\"width:24px;height:24px\"></ha-icon>"
    },
    "extra_styles": ":host{display:block;height:100%;min-height:0;} ha-card{height:100%;} ha-card::before,ha-card::after{display:none!important;content:none!important}"
  },
  "bc_metric": {
    "template": "bc_action",
    "styles": {
      "grid": [
        {
          "grid-template-areas": "\"i n\" \"value value\" \"l l\""
        },
        {
          "grid-template-columns": "60px minmax(0,1fr)"
        },
        {
          "grid-template-rows": "40px minmax(0,1fr) 46px"
        },
        {
          "row-gap": "12px"
        }
      ],
      "icon": [
        {
          "width": "40px"
        }
      ],
      "label": [
        {
          "justify-self": "start"
        },
        {
          "text-align": "left"
        },
        {
          "white-space": "normal"
        },
        {
          "line-height": 1.35
        }
      ],
      "name": [
        {
          "font-size": "var(--bc-font)"
        }
      ],
      "custom_fields": {
        "value": [
          {
            "justify-self": "start"
          },
          {
            "text-align": "left"
          },
          {
            "font-size": "[[[ return !entity||['unknown','unavailable'].includes(entity.state)||variables.value_attribute||!isNaN(Number(entity.state))?'var(--bc-value)':'clamp(24px,2vw,42px)'; ]]]"
          },
          {
            "font-weight": 600
          },
          {
            "line-height": 1.1
          },
          {
            "white-space": "normal"
          },
          {
            "overflow-wrap": "anywhere"
          }
        ],
        "arrow": [
          {
            "display": "none"
          }
        ],
        "chart": [
          {
            "position": "absolute"
          },
          {
            "width": "29%"
          },
          {
            "height": "80px"
          },
          {
            "right": "22px"
          },
          {
            "bottom": "60px"
          }
        ],
        "decor": [
          {
            "position": "absolute"
          },
          {
            "width": "70px"
          },
          {
            "height": "70px"
          },
          {
            "right": "32px"
          },
          {
            "top": "45%"
          },
          {
            "color": "#39758d"
          }
        ]
      }
    },
    "custom_fields": {
      "value": "[[[ const invalid=v=>v===undefined||v===null||v===''||['unknown','unavailable'].includes(String(v)); const esc=v=>String(v).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c])); const e=entity; let v=variables.value_attribute?e?.attributes?.[variables.value_attribute]:e?.state; const guards=[...(variables.guard_entity?[variables.guard_entity]:[]),...(variables.guard_entities||[])]; if (invalid(v)||guards.some(id=>invalid(states[id]?.state))) return '—'; if(!isNaN(Number(v))) v=Number(v).toLocaleString(hass.locale.language,{minimumFractionDigits:variables.decimals??0,maximumFractionDigits:variables.decimals??1}); else v=variables.state_labels?.[v] || e?.attributes?.state_ru || (typeof hass.formatEntityState==='function'?hass.formatEntityState(e):({'on':'Вкл','off':'Выкл'}[v]||v)); const unit=variables.unit??e?.attributes?.unit_of_measurement??''; return esc(v)+(unit?'<span style=\"font-size:var(--bc-unit);font-weight:400;margin-left:10px\">'+esc(unit)+'</span>':''); ]]]",
      "arrow": ""
    },
    "label": "[[[ if(!entity||['unknown','unavailable'].includes(entity.state)||[...(variables.guard_entity?[variables.guard_entity]:[]),...(variables.guard_entities||[])].some(id=>!states[id]||['unknown','unavailable'].includes(states[id].state))) return 'Нет данных'; if(variables.description_entity){let e=states[variables.description_entity]; return e?.attributes?.description_ru || e?.state || '';} return variables.caption || ''; ]]]"
  },
  "bc_nav": {
    "template": "bc_action",
    "show_icon": false,
    "show_label": false,
    "styles": {
      "card": [
        {
          "padding": "14px 12px"
        },
        {
          "border-radius": "18px"
        },
        {
          "height": "100%"
        }
      ],
      "grid": [
        {
          "grid-template-areas": "\"n\""
        },
        {
          "grid-template-columns": "1fr"
        }
      ],
      "name": [
        {
          "justify-self": "center"
        },
        {
          "white-space": "nowrap"
        },
        {
          "font-size": "var(--bc-font)"
        }
      ],
      "custom_fields": {
        "arrow": [
          {
            "display": "none"
          }
        ]
      }
    }
  },
  "bc_brand": {
    "template": "bc_action",
    "show_name": false,
    "show_label": false,
    "styles": {
      "card": [
        {
          "background": "transparent"
        },
        {
          "border": "none"
        },
        {
          "padding": "0"
        }
      ],
      "grid": [
        {
          "grid-template-areas": "\"i\""
        },
        {
          "grid-template-columns": "1fr"
        }
      ],
      "icon": [
        {
          "width": "70px"
        }
      ],
      "custom_fields": {
        "arrow": [
          {
            "display": "none"
          }
        ]
      }
    }
  },
  "bc_clock": {
    "template": "bc_action",
    "show_icon": false,
    "styles": {
      "card": [
        {
          "background": "transparent"
        },
        {
          "border": "none"
        },
        {
          "padding": "6px"
        }
      ],
      "grid": [
        {
          "grid-template-areas": "\"l\" \"time\""
        },
        {
          "grid-template-columns": "1fr"
        },
        {
          "grid-template-rows": "1fr 1fr"
        }
      ],
      "label": [
        {
          "justify-self": "end"
        },
        {
          "font-size": "var(--bc-small)"
        }
      ],
      "custom_fields": {
        "time": [
          {
            "justify-self": "end"
          },
          {
            "font-size": "clamp(24px,2.3vw,40px)"
          },
          {
            "letter-spacing": "2px"
          }
        ],
        "arrow": [
          {
            "display": "none"
          }
        ]
      }
    }
  },
  "bc_small": {
    "template": "bc_metric",
    "styles": {
      "card": [
        {
          "padding": "18px 22px"
        }
      ],
      "grid": [
        {
          "grid-template-rows": "30px minmax(0,1fr) 30px"
        },
        {
          "row-gap": "2px"
        }
      ],
      "name": [
        {
          "font-size": "var(--bc-small)"
        }
      ],
      "icon": [
        {
          "width": "30px"
        }
      ],
      "custom_fields": {
        "value": [
          {
            "font-size": "clamp(22px,2.2vw,36px)"
          }
        ]
      }
    }
  },
  "bc_weather": {
    "template": "bc_metric",
    "styles": {
      "grid": [
        {
          "grid-template-areas": "\"n n n\" \"i value value\" \"condition feels feels\" \"l l l\""
        },
        {
          "grid-template-columns": "110px minmax(0,1fr) minmax(0,1fr)"
        },
        {
          "grid-template-rows": "40px minmax(0,1fr) 35px 36px"
        },
        {
          "row-gap": "8px"
        }
      ],
      "icon": [
        {
          "width": "100px"
        }
      ],
      "custom_fields": {
        "condition": [
          {
            "text-align": "left"
          },
          {
            "justify-self": "start"
          },
          {
            "font-size": "var(--bc-small)"
          }
        ],
        "feels": [
          {
            "text-align": "left"
          },
          {
            "justify-self": "start"
          },
          {
            "font-size": "var(--bc-small)"
          },
          {
            "color": "#9fc5d6"
          }
        ]
      },
      "entity_picture": [
        {
          "width": "110px"
        },
        {
          "height": "110px"
        },
        {
          "border-radius": "0"
        },
        {
          "filter": "brightness(0) saturate(100%) invert(72%) sepia(39%) saturate(1490%) hue-rotate(160deg) brightness(99%) contrast(89%)"
        }
      ]
    },
    "custom_fields": {
      "condition": "[[[ const labels={sunny:'Ясно','clear-night':'Ясно',partlycloudy:'Облачно',cloudy:'Пасмурно',rainy:'Дождь',pouring:'Ливень',lightning:'Гроза','lightning-rainy':'Гроза',fog:'Туман',snowy:'Снег',windy:'Ветер'}; return labels[entity?.state] || 'Нет данных'; ]]]",
      "feels": "[[[ const raw=states[variables.feels_like_entity]?.state; if(raw===undefined||['unknown','unavailable'].includes(raw))return ''; const n=Number(raw);return Number.isFinite(n)?'Ощущается '+Math.round(n)+'°':''; ]]]"
    },
    "show_entity_picture": true,
    "entity_picture": "[[[ const night=states['sun.sun']?.state==='below_horizon'; const map={'clear-night':'clear-night',sunny:night?'clear-night':'clear-day',cloudy:'cloudy',partlycloudy:night?'partly-cloudy-night':'partly-cloudy-day',rainy:night?'overcast-night-rain':'overcast-day-rain',pouring:night?'extreme-night-rain':'extreme-day-rain',lightning:night?'thunderstorms-night':'thunderstorms-day','lightning-rainy':night?'thunderstorms-night-rain':'thunderstorms-day-rain',fog:night?'fog-night':'fog-day',snowy:'snow','snowy-rainy':'sleet',windy:'wind'}; return 'https://cdn.jsdelivr.net/gh/w4mhi/weather-chart-card-ha@v1.7.4/dist/icons/'+(map[entity?.state]||'cloudy')+'.svg'; ]]]"
  },
  "bc_forecast_slot": {
    "template": "bc_action",
    "show_name": false,
    "show_label": true,
    "styles": {
      "card": [
        {
          "background": "transparent"
        },
        {
          "border": "none"
        },
        {
          "padding": "0"
        }
      ],
      "grid": [
        {
          "grid-template-areas": "\"i\" \"temperature\" \"l\""
        },
        {
          "grid-template-columns": "1fr"
        },
        {
          "grid-template-rows": "55px 30px 25px"
        }
      ],
      "icon": [
        {
          "width": "54px"
        }
      ],
      "label": [
        {
          "font-size": "22px"
        }
      ],
      "custom_fields": {
        "arrow": [
          {
            "display": "none"
          }
        ],
        "temperature": [
          {
            "font-size": "28px"
          },
          {
            "color": "#dceef5"
          }
        ]
      },
      "entity_picture": [
        {
          "width": "68px"
        },
        {
          "height": "68px"
        },
        {
          "border-radius": "0"
        },
        {
          "filter": "brightness(0) saturate(100%) invert(72%) sepia(39%) saturate(1490%) hue-rotate(160deg) brightness(99%) contrast(89%)"
        }
      ]
    },
    "extra_styles": "ha-card::before,ha-card::after{display:none!important;content:none!important}"
  }
}
